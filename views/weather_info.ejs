<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <title>Weather</title>
        <link 
        rel="stylesheet"
        href="/styles2.css"
        />
    </head>
    <body>
        <h1><%=weather_title%></h1>
        <div class="weather-box">
            <div class="icon"><img src=<%=weather_icon%>></div>
            <div class="desc"><h2><%=weather_desc%></h2></div>
            <div class="date"><h3><%=city_date%> <%=city_mon%>, <%=city_year%></h3>
                <h3><%=city_day%></h3></div>
            <div class="temp"><h3>Temp:<%=weather_temp%>°C</h3></div>
            <div class="feel_like"><h3>Feels like <%=weather_feels_like%>°C</h3></div>
            <div class="hum"><h3>Humidity:<%=humidity%>%</h3></div>
            <div class="prec"><h3>Precipitation:<%=prec%> mm</h3></div>
            <div class="wind"><h3>Wind Speed:<%=windSpeed%> km/h</h3></div>
            <div class="pres"><h3>Pressure:<%=pressure%> hPa</h3></div>
        </div>
        <div class="redirect"><form action="/" method="GET">
            <button type="submit">Go back to location search</button>
           </form></div>
    </body>
</html>
